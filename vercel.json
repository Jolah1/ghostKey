{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ghostkey-web && npm install && npm run build",
  "outputDirectory": "ghostkey-web/dist",
  "framework": null,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ghostkey.fly.dev/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    }
  ]
}
