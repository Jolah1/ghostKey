# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — do not commit your real secrets.
#
# Load it into your shell before starting the server, e.g.:
#   set -a; source .env; set +a
#   cargo run -p ghostkey-server

# Required for the AI guide chat (POST /assist/chat). When unset, the
# chat panel hides itself; nothing else breaks. Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required for vault encryption-at-rest. 32 random bytes, base64-encoded.
# Generate with: openssl rand -base64 32
GHOSTKEY_MASTER_KEY=

# Optional: override the default Esplora indexer. Required for mainnet
# (must be HTTPS); for testnet/signet/regtest, defaults are fine.
# GHOSTKEY_ESPLORA_URL=https://your-esplora.example.com/api

# Optional: tighten browser CORS to your deployed frontend. Comma-separated.
# GHOSTKEY_CORS_ORIGINS=https://ghostkey.yourdomain.com

# Optional: SMS + WhatsApp delivery via Twilio. Both credentials are
# required; the two senders are enabled independently, so you can run
# SMS-only or WhatsApp-only.
#
# The senders must be REAL numbers provisioned on your Twilio account.
# A placeholder is not harmless: Twilio accepts a WhatsApp send from an
# unknown From with 201 queued and only fails it asynchronously (error
# 63007), so the message looks sent and never arrives. We reject
# non-E.164 values and the reserved NANP 555 ranges at boot and report
# the channel as disabled on /health rather than pretend.
#
# For local dev, the Twilio WhatsApp sandbox sender is +14155238886 —
# recipients must first text "join <your-code>" to it.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# Your provisioned number, E.164, no spaces. Left blank on purpose:
# there is no safe fake to copy here.
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=+14155238886
